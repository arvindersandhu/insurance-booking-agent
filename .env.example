# Copy this file to .env and fill in your real values.
# NEVER commit a filled-in .env file or share it with anyone.
# Every value here is a placeholder — the server runs in test/mock mode without them.

# --- Meta / Instagram ---
# Your Meta app's "Verify Token" — you invent this word, then type the same word
# in the Meta developer dashboard when you set up the webhook.
META_VERIFY_TOKEN=change-me-verify-token

# Your Instagram Business account's Page access token (from Meta developer dashboard).
# Leave empty to run in dry-run mode (messages are logged, not sent).
IG_PAGE_ACCESS_TOKEN=

# Your Instagram Business account ID (the "ig_user_id" number from Meta).
IG_USER_ID=

# --- OpenAI-compatible AI replies ---
# Leave empty to use the built-in scripted replies (no AI needed).
# Set it to use real AI-written replies instead.
OPENAI_API_KEY=
# Only change this if you use a different AI provider with the same style of API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Google Calendar ---
# Leave empty to use the built-in mock calendar (bookings are stored in memory).
# To use a real calendar, create a Google Cloud service account, share your
# calendar with its email address, and fill these in:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# --- Server ---
PORT=3000
# Your own calendar timezone, e.g. America/Regina
TIMEZONE=America/Regina
